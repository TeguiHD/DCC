Options -Indexes -MultiViews

<FilesMatch "(^\.|\.env|composer\.(json|lock)|package(-lock)?\.json|vite\.config\.js|phpunit\.xml|artisan|README\.md|.*\.md|.*\.zip|.*\.rar|.*\.7z|.*\.tar|.*\.gz)$">
    Require all denied
</FilesMatch>

RedirectMatch 403 ^/(app|archive|bootstrap|config|database|docs|node_modules|resources|routes|storage|tests|vendor)(/|$)

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTP_HOST} ^www\.ddcpublicidad\.cl$ [NC]
    RewriteRule ^ https://ddcpublicidad.cl%{REQUEST_URI} [R=301,L,NE]

    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

    RewriteCond %{THE_REQUEST} \s/+public/([^\s?]*) [NC]
    RewriteRule ^public/(.*)$ /$1 [R=301,L,NE]

    RewriteRule ^$ public/index.php [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
